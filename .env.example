# ─── Application (Production: https://erp.printg.uz & https://s3.printg.uz) ───
NODE_ENV=development
NEXT_PUBLIC_APP_URL=https://erp.printg.uz
APP_DOMAIN=erp.printg.uz
S3_PUBLIC_DOMAIN=s3.printg.uz

# ─── PostgreSQL 17 (Drizzle ORM) ──────────────────────────────────────────────
POSTGRES_USER=printgoo
POSTGRES_PASSWORD=printgoo_dev_secret
POSTGRES_DB=printgoo_erp
POSTGRES_PORT=5432
DATABASE_URL=postgresql://printgoo:printgoo_dev_secret@localhost:5432/printgoo_erp

# ─── Redis 7 (Cache, Sessions, BullMQ, SSE PubSub) ────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── MinIO / S3 Compatible Object Storage ─────────────────────────────────────
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
S3_INTERNAL_ENDPOINT=http://localhost:9000
NEXT_PUBLIC_S3_ENDPOINT=https://s3.printg.uz
S3_REGION=us-east-1
S3_ACCESS_KEY=printgoo_minio
S3_SECRET_KEY=printgoo_minio_secret_key
S3_BUCKET_PREPRESS=printgoo-prepress
S3_BUCKET_DOCS=printgoo-docs
S3_BUCKET_THUMBNAILS=printgoo-thumbnails

# ─── Auth & Security (Better-Auth / RBAC) ─────────────────────────────────────
BETTER_AUTH_SECRET=printgoo_super_secret_auth_key_change_in_production_2026
BETTER_AUTH_URL=https://erp.printg.uz
INITIAL_ADMIN_PASSWORD=admin

# ─── External Integrations (Telegram Bot & CBU Currency API) ──────────────────
TELEGRAM_BOT_TOKEN=
CBU_API_URL=https://cbu.uz/oz/arkhiv-kursov-valyut/json/

# ─── Python Document Service (ReportLab PDF, DOCX, XLSX, QR/Barcodes) ─────────
DOC_SERVICE_PORT=8000
DOC_SERVICE_URL=http://localhost:8000
